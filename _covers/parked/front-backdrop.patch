+/* The front page's backdrop (see the stylesheet). Pointing at the Work row
+   puts a case's wide shot behind the page and steps to the next case at an
+   interval while the pointer stays; it picks up where it left off the next
+   time. The shots are fetched at the first pointing, never before, and one
+   ahead after that. Where motion is unwelcome there is one shot and no
+   stepping. Each entry: the case, its name, the shot, and where in the
+   shot the device's middle is, as shares of its width and height. */
+(() => {
+	const row = document.querySelector('.index__row[data-covers]');
+	if (!row || !window.matchMedia('(hover: hover) and (min-width: 1101px)').matches) return;
+	/* TRIAL: only with ?preview in the address until it is approved */
+	if (!/[?&]preview\b/.test(location.search)) return;
+
+	const SHOTS = [
+		['economic', 'Visma e-conomic', 'front', 0.508, 0.451],
+		['trackman', 'TrackMan', 'front', 0.486, 0.472],
+		['donkey', 'Donkey Republic', 'front', 0.498, 0.467],
+		['tv2', 'TV2 Regionerne', 'front', 0.498, 0.501],
+		['ok', 'OK', 'front', 0.489, 0.519],
+		['theorg', 'The Org', 'front', 0.527, 0.438],
+	];
+	const HOLD = 2400;
+	const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+	const at = new URL('../img/work/', row.href).pathname;
+
+	let room = null;
+	let label = null;
+	let shots = [];
+	let now = -1;
+	let timer = null;
+
+	const fetchShot = (i) => {
+		const img = shots[i];
+		if (img.src) return;
+		const [slug, , file] = SHOTS[i];
+		img.sizes = Math.ceil(img.getBoundingClientRect().width || window.innerWidth * 1.6) + 'px';
+		img.srcset = at + slug + '/' + file + '-2400.webp 2400w, ' + at + slug + '/' + file + '.webp 3200w';
+		img.src = at + slug + '/' + file + '-2400.webp';
+	};
+
+	const show = (i) => {
+		now = i;
+		fetchShot(i);
+		fetchShot((i + 1) % SHOTS.length);
+		shots.forEach((img, k) => img.classList.toggle('is-up', k === i));
+		label.firstChild.textContent = SHOTS[i][1];
+		label.lastChild.textContent = (i + 1) + ' / ' + SHOTS.length;
+	};
+
+	const build = () => {
+		room = document.createElement('div');
+		room.className = 'backdrop';
+		room.setAttribute('aria-hidden', 'true');
+		shots = SHOTS.map(([, , , ix, iy]) => {
+			const img = new Image();
+			img.alt = '';
+			img.decoding = 'async';
+			img.style.setProperty('--ix', ix);
+			img.style.setProperty('--iy', iy);
+			room.appendChild(img);
+			return img;
+		});
+		label = document.createElement('p');
+		label.className = 'backdrop__name';
+		label.setAttribute('aria-hidden', 'true');
+		label.append(document.createElement('b'), document.createElement('span'));
+		document.body.append(room, label);
+	};
+
+	row.addEventListener('pointerenter', () => {
+		if (!room) build();
+		/* the rows' height, so the name can stand just above them */
+		label.style.setProperty('--rows', Math.round(window.innerHeight - row.getBoundingClientRect().top) + 'px');
+		show(now < 0 ? 0 : now);
+		document.body.classList.add('in-a-room');
+		if (!still) timer = setInterval(() => show((now + 1) % SHOTS.length), HOLD);
+	});
+	row.addEventListener('pointerleave', () => {
+		clearInterval(timer);
+		document.body.classList.remove('in-a-room');
+	});
+})();
