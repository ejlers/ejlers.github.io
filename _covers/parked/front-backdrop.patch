+/* --- The front page's backdrop ---------------------------------------- */
+
+/* Pointing at the Work row turns the page into the work: a case's wide
+   shot takes the whole window, behind everything, and gives way to the
+   next case every few seconds for as long as the pointer stays. The page
+   does not move: the name, the claim and the rows stand where they stood,
+   now in a room. The portrait steps out while it lasts, since a room holds
+   one picture.
+
+   Each shot is placed, not cropped: the device's own middle lands on the
+   middle of the open ground, right of the claim and above the rows, and
+   the picture is made exactly large enough to reach all four edges of the
+   window from there (--ix and --iy say where the device is in its shot;
+   site.js sets them per case).
+
+   The shots are light in both schemes, so the page's ink is the dark one
+   in both while a shot is up, and its greys are that ink thinned, the way
+   the words on a case's header are. Only where a pointer can hover, and
+   only on a desk: below the columns there is no open ground to stand in. */
+.backdrop {
+	--tx: calc(50vw + 300px);
+	--ty: calc(50vh - 120px);
+	position: fixed;
+	inset: 0;
+	z-index: -1;
+	overflow: hidden;
+	background: var(--canvas);
+	opacity: 0;
+	pointer-events: none;
+	transition: opacity var(--t-close) ease-in;
+}
+
+.backdrop img {
+	--h: max(calc(var(--ty) / var(--iy)), calc((100vh - var(--ty)) / (1 - var(--iy))), calc(var(--tx) / (2 * var(--ix))), calc((100vw - var(--tx)) / (2 * (1 - var(--ix)))));
+	position: absolute;
+	left: calc(var(--tx) - var(--h) * 2 * var(--ix));
+	top: calc(var(--ty) - var(--h) * var(--iy));
+	width: calc(var(--h) * 2);
+	height: var(--h);
+	max-width: none;
+	opacity: 0;
+	transition: opacity var(--t-develop) ease;
+}
+
+.backdrop img.is-up {
+	opacity: 1;
+}
+
+/* Which case it is, on the page's left edge just above the rows: under the
+   claim, the one corner every shot leaves open. */
+.backdrop__name {
+	position: fixed;
+	left: max(var(--page-x), calc((100vw - var(--page-max)) / 2));
+	bottom: calc(var(--rows) + var(--s3));
+	display: flex;
+	gap: var(--s2);
+	color: var(--ink-muted);
+	opacity: 0;
+	pointer-events: none;
+	transition: opacity var(--t-close) ease-in;
+}
+
+.backdrop__name b {
+	color: var(--ink);
+}
+
+.in-a-room .backdrop,
+.in-a-room .backdrop__name {
+	opacity: 1;
+	transition: opacity var(--t-open) ease-out;
+}
+
+body.in-a-room {
+	--on-shot: var(--ink);
+	--ink-muted: color-mix(in srgb, var(--on-shot) 68%, transparent);
+	--grey: color-mix(in srgb, var(--on-shot) 50%, transparent);
+	--rule: color-mix(in srgb, var(--on-shot) 14%, transparent);
+	--hover: color-mix(in srgb, var(--on-shot) 5%, transparent);
+	background: transparent;
+}
+
+@media screen and (prefers-color-scheme: dark) {
+	body.in-a-room {
+		--on-shot: var(--paper);
+		--ink: var(--on-shot);
+	}
+}
+
+.in-a-room .opener {
+	background: transparent;
+}
+
+/* Words and lines change ink at the pace the shot comes and goes, so they
+   are never the page's colour on the shot or the shot's on the page. */
+.floor .crumb__here,
+.floor .display,
+.floor .index__row,
+.floor .index__note,
+.floor .index__arrow,
+.floor .portrait-mark {
+	transition: color var(--t-open) ease, border-color var(--t-open) ease, background-color var(--t-confirm) ease, opacity var(--t-open) ease;
+}
+
+.in-a-room .portrait-mark {
+	opacity: 0;
+}
+
 /* --- Ending --------------------------------------------------------- */
 
